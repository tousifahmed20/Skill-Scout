{
  "checked_on": "2026-10-11",
  "sources": {
    "paths_and_feature_support": "https://github.com/vercel-labs/skills (README: supported agents table and feature notes)",
    "spec_fields": "https://agentskills.io/specification",
    "claude_code_extensions": "https://code.claude.com/docs/en/skills",
    "mcp_and_runners": "verified 2026-10-11 against vendor docs/changelogs: Codex (codex exec; mcp_servers in config.toml), Gemini CLI (settings.json MCP; gemini -p), Antigravity (mcp_config.json serverUrl; headless `agy -p` per antigravity.google/docs/cli/headless), Cursor (cursor-agent -p; .cursor/mcp.json; agent mcp), GitHub Copilot CLI (copilot -p; built-in + custom MCP), Cline (cline_mcp_settings.json; CLI 2.0 headless `cline -y` per docs.cline.bot/cline-cli), Kiro CLI (~/.kiro/settings/mcp.json; 2.0 headless `kiro-cli chat --no-interactive` with KIRO_API_KEY per kiro.dev/docs/cli/headless). All 8 verification_runners now confirmed (stage 07)."
  },
  "default_display": [
    "claude-code",
    "codex",
    "gemini-cli",
    "antigravity",
    "cursor",
    "github-copilot"
  ],
  "harnesses": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "install_agent_flag": "claude-code",
      "skill_paths": {
        "project": ".claude/skills/",
        "global": "~/.claude/skills/"
      },
      "supports": {
        "agent_skills": true,
        "allowed_tools": true,
        "claude_code_extensions": true,
        "context_fork": true,
        "hooks": true,
        "body_injection": true,
        "argument_substitution": true,
        "mcp": true,
        "shell": true
      },
      "verification_runner": "subagent or `claude -p`",
      "detect_env": {
        "CLAUDECODE": "1"
      },
      "tool_lexicon": [
        "TodoWrite",
        "AskUserQuestion",
        "ExitPlanMode",
        "NotebookEdit",
        "Task tool"
      ],
      "unverified": []
    },
    {
